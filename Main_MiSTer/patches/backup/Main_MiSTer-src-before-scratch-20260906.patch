+static bool input_xgunner_reload_cb(int dev, struct input_event *ev)
+{
+	if (!input_is_xgunner(dev) || !input[dev].lightgun || user_io_osd_is_visible()) return false;
+	if (ev->type != EV_KEY || ev->value > 1) return false;
+
+	uint32_t reload = input[dev].map[XGUNNER_RELOAD_MAP_SLOT];
+	if (!reload || (ev->code != (reload & 0xFFFF) && ev->code != (reload >> 16))) return false;
+
+	if (ev->value)
+	{
+		joy_analog(dev, 0, 127);
+		joy_analog(dev, 1, 127);
+	}
+
+	for (uint i = 0; i < BTN_NUM; i++)
+	{
+		if (i == XGUNNER_RELOAD_MAP_SLOT) continue;
+		if ((input[dev].map[i] & 0xFFFF) == BTN_LEFT || (input[dev].map[i] >> 16) == BTN_LEFT)
+		{
+			joy_digital(input[dev].num, 1u << i, BTN_LEFT, ev->value, i);
+		}
+	}
+
+	return true;
+}
