+static bool input_is_xgunner(int idx)
+{
+	return input[idx].vid == 0x1209 && input[idx].pid >= 0x0001 && input[idx].pid <= 0x0004 &&
+		(strstr(input[idx].name, "XGUNNER") || strstr(input[idx].id, "XGUNNER"));
+}
+
+static void input_xgunner_setup(int idx)
+{
+	input[idx].quirk = QUIRK_LIGHTGUN_MOUSE;
+	input[idx].lightgun = 1;
+	input[idx].num = input[idx].pid & 0xf;
+	input[idx].guncal[0] = 0;
+	input[idx].guncal[1] = 32767;
+	input[idx].guncal[2] = 0;
+	input[idx].guncal[3] = 32767;
+	input_lightgun_load(idx);
